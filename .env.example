# Optional for local preview. Without DATABASE_URL, Signal shows a labeled sample edition.
DATABASE_URL=
# Direct Neon URL for migrations (never the -pooler host).
DATABASE_URL_UNPOOLED=
# No model key or AI-provider account is needed. Curation and grouping run locally.
# openssl rand -hex 32 — required even in development for the HTTP cron route.
CRON_SECRET=
# Optional: higher GitHub API quota. Public repositories only; no write scopes needed.
GITHUB_TOKEN=
# Flowmark project write key from Studio Settings. Set this yourself. Never commit it or prefix it with NEXT_PUBLIC_.
FLOWMARK_API_KEY=
# API origin, not a /v1/events path.
FLOWMARK_API_URL=https://api.flowmark.dev
# Public canonical URL, used for metadata, sitemap and RSS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

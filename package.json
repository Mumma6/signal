{
  "name": "signal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "briefing:generate": "node --conditions=react-server --import tsx scripts/generate.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "sources:check": "node --conditions=react-server --import tsx scripts/check-sources.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview:refresh": "node --conditions=react-server --import tsx scripts/preview.ts",
    "radar:refresh": "node --conditions=react-server --import tsx scripts/refresh-radar.ts",
    "briefing:revise": "node --conditions=react-server --import tsx scripts/revise-briefing.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@flowmarkdev/node": "^0.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vercel/functions": "^3.11.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
